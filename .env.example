# --- pey (obligatorio) ---
PEY_API_KEY=
# Secreto que entrega el portal de pey al crear el webhook (empieza con whsec_)
PEY_WEBHOOK_SECRET=
PEY_BASE_URL=https://api.pey.mx

# --- Negocio ---
# Zona horaria para decir las horas y calcular "hoy" (el servidor corre en UTC)
BUSINESS_TZ=America/Mexico_City
# Nombre que ve el cliente al pagar el QR fijo
BUSINESS_NAME=Mi tienda
# Opcional: cómo se muestra en el perfil la cuenta donde cae el dinero
DEPOSIT_ACCOUNT_LABEL=
# Opcional: segundos que dura un cobro al celular (mínimo 360)
PUSH_EXPIRATION=900
# Opcional: amarra el QR fijo a la cuenta (sobrevive reinicios y deploys).
# Se obtienen del QR fijo ya creado (tabla charges, kind='fixed').
FIXED_QR_ID=
FIXED_QR_STRING=
# Expiración de los QR con monto en segundos (0 = no expira; si se define, mínimo 360)
DEFAULT_EXPIRATION=0

# --- Respaldo del webhook ---
# Cada cuántos segundos se consulta a pey mientras haya una pantalla conectada (0 = apagado)
RECOVERY_POLL_SECONDS=45
# Solo se anuncian en voz los pagos de los últimos N segundos; los más viejos van al historial
ANNOUNCE_WINDOW_SECONDS=120

# --- Seguridad ---
# PIN para entrar a Ajustes y para acciones de administración (vacío = sin PIN)
ADMIN_PIN=

# --- Voz (opcional; sin llave se usa la voz del navegador) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_flash_v2_5

# --- Asistente (opcional; sin llave funciona con reglas simples) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5

# --- Pruebas: permite simular pagos (se anuncian como "Simulación") ---
ALLOW_SIMULATION=false

# --- Base de datos (en Railway, apunta al volumen: /data/bocina.db) ---
DB_PATH=

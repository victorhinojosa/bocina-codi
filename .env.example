# --- pey (obligatorio) ---
PEY_API_KEY=
# Secreto que entrega el portal de pey al crear el webhook (empieza con whsec_)
PEY_WEBHOOK_SECRET=
PEY_BASE_URL=https://api.pey.mx

# --- Negocio ---
# Zona horaria para decir las horas y calcular "hoy" (el servidor corre en UTC)
BUSINESS_TZ=America/Mexico_City
# Opcional: segundos que dura un cobro al celular (mínimo 360)
PUSH_EXPIRATION=900
# Expiración de los QR con monto en segundos (0 = no expira; si se define, mínimo 360)
DEFAULT_EXPIRATION=0

# --- Respaldo del webhook ---
# Cada cuántos segundos se consulta a pey mientras haya una pantalla conectada (0 = apagado)
RECOVERY_POLL_SECONDS=45
# Solo se anuncian en voz los pagos de los últimos N segundos; los más viejos van al historial
ANNOUNCE_WINDOW_SECONDS=120

# --- Cuenta demo (Ramón) ---
# Sus credenciales se muestran en /app en computadora para que cualquiera entre (jueces, visitas).
# Cobra en la cuenta CoDi de la API key y se queda con los pagos de antes de las cuentas.
DEMO_PHONE=
DEMO_PIN=
DEMO_FIRST_NAME=Ramón
DEMO_LAST_NAME=Demo
# Nombre del negocio demo y cómo se muestra su cuenta de depósito
BUSINESS_NAME=Abarrotes Don Ramon
DEPOSIT_ACCOUNT_LABEL=
# QR fijo de la demo amarrado (sobrevive reinicios y deploys)
FIXED_QR_ID=
FIXED_QR_STRING=
# Cobro al celular en la demo (manda una solicitud real a un celular real)
DEMO_PUSH_PER_SESSION=3
DEMO_PUSH_PER_DAY=30
DEMO_PUSH_MAX_AMOUNT=50

# --- Administración (/api/admin/...): vacío = apagada; usa un valor largo y aleatorio ---
ADMIN_TOKEN=

# --- Link de pago ---
# URL pública https:// para las páginas de regreso del link (vacío = la del proxy de Railway; útil con ngrok)
PUBLIC_URL=

# --- Sesiones ---
# Días que dura la sesión en el celular antes de volver a pedir el PIN
SESSION_DAYS=90

# --- Voz (opcional; sin llave se usa la voz del navegador) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=ewn5JTa3lNPY8QVuZJi6
ELEVENLABS_MODEL=eleven_flash_v2_5

# --- Asistente (opcional; sin llave funciona con reglas simples) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5

# --- Pruebas: permite simular pagos (se anuncian como "Simulación") ---
ALLOW_SIMULATION=false

# --- Base de datos (en Railway, apunta al volumen: /data/bocina.db) ---
DB_PATH=
